async function postBPDataCalibration(data) {
  let request = new XMLHttpRequest();
  let loc = window.location;
  let url = `${loc.protocol}//${loc.hostname}:${loc.port}/api/v1/calibrate_bp`;
  request.open("POST", url, true);
  request.setRequestHeader("Content-Type", "application/json");
  request.onload = function (e) {
    request = this;
    if (request.readyState === 4) {
      let response = JSON.parse(e.target.responseText);
      if (request.status === 200) {
        console.log("Calibrate BP response:", response);
        diastolicAdjustment = response.diastolic_adjustment;
        systolicAdjustment = response.systolic_adjustment;
        el("bpText").innerHTML = "YES";
        if (!(el("bpResult").innerText.split("/")[0] == "-- / --")) {
          let sys = parseInt(el("bpResult").innerText.split("/")[0] * systolicAdjustment);
          let dia = parseInt(el("bpResult").innerText.split("/")[1] * diastolicAdjustment);
          el("bpResult").innerHTML = sys + " / " + dia;
        }
      } else {
        let error_text =
          "Failed to calibrate BP. Error status: " +
          request.status +
          ". Detail: " +
          request.detail.loc[1] +
          " index: " +
          request.detail.loc[2] +
          " " +
          request.detail[0].msg;
        console.error(error_text);
        alert(error_text);
      }
    }
  };
  request.send(JSON.stringify(data));
}

