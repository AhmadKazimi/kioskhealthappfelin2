function validateBPInput(inputNum) {
  let userBPInput = el("userBPInput" + inputNum);
  let systemBPInput = el("systemBPInput" + inputNum);
  let errorText = "";
  let userDiastolic;
  let userSystolic;
  let systemDiastolic;
  let systemSystolic;

  if (!userBPInput.value || !userBPInput.validity.valid) {
    errorText += "User BP Input " + inputNum + " ";
  } else {
    userDiastolic = parseInt(userBPInput.value.split("/")[1]);
    if (userDiastolic > 100 || userDiastolic < 60) {
      errorText += "User BP Input " + inputNum + ": Diastolic should be greater than 90 and less than 180mmHG ";
    }
    userSystolic = parseInt(userBPInput.value.split("/")[0]);
    if (userSystolic > 180 || userSystolic < 90) {
      errorText += "User BP Input " + inputNum + ": Systolic should be greater than 60 and less than 100mmHG ";
    }
  }
  if (!systemBPInput.value || !systemBPInput.validity.valid) {
    errorText += "System BP Input " + inputNum + " ";
  } else {
    systemDiastolic = parseInt(systemBPInput.value.split("/")[1]);
    if (systemDiastolic > 100 || systemDiastolic < 60) {
      errorText += "System BP Input " + inputNum + ": Diastolic should be greater than 90 and less than 180mmHG ";
    }
    systemSystolic = parseInt(systemBPInput.value.split("/")[0]);
    if (systemSystolic > 180 || systemSystolic < 90) {
      errorText += "System BP Input " + inputNum + ": Systolic should be greater than 60 and less than 100mmHG ";
    }
  }
  return {
    userDiastolic: userDiastolic,
    userSystolic: userSystolic,
    systemDiastolic: systemDiastolic,
    systemSystolic: systemSystolic,
    errorText: errorText,
  };
}

