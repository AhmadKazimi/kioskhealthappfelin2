function joinRoom() {
  if (window.screen.width < 1025) {
    remoteVidLabel.classList.remove("hidden");
    remoteCanvasEl.classList.remove("hidden");
  }

  if (loc.protocol === "http:") {
    meetingSocket = io("ws://" + loc.hostname + ":" + loc.port + "/api/v1/meeting", {
      transports: ["websocket"],
      auth: {},
      forceNew: true,
    });
  } else {
    meetingSocket = io("wss://" + loc.hostname + ":" + loc.port + "/api/v1/meeting", {
      transports: ["websocket"],
      forceNew: true,
      auth: {},
    });
  }
  // console.log("meeting_socket", meetingSocket);

  meetingSocket.on("created", (room) => {
    console.log("room name: " + room + " created.");
    inRoom = true;
    callAction(room);
  });

  meetingSocket.on("joined", (room) => {
    console.log("room name: " + room + " joined");
    inRoom = true;
    callAction(room);
  });

  meetingSocket.on("full", (room) => {
    console.log("room name: " + room + " can't add another user ");
    alert("Room full, please choose another room");
  });

  meetingSocket.on("token", (token) => {
    agoraToken = token;
    // console.log('token', token);
  });

  meetingSocket.on("getting_vitals", (data) => {
    console.log("room name: " + data["room"] + " getting vitals...");
    el("getVitals").setAttribute("disabled", true);

    if (data["selectedContainer"] === "remoteVideo") {
      // localVideoContainer.classList.add('hidden');
      // canvasEl.classList.remove('hidden');
      el("localFramesNeeded").classList.remove("hidden");
      el("localFramesNeededLabel").classList.remove("hidden");

      stableReadingsEl.classList.remove("hidden");
      stableReadingsEl.innerHTML =
        "Wait for stable readings... <br>Keep very still and look at the camera.<br>If the box doesn't turn green within 30secs please try again.";

      dst = new cv.Mat();

      bbColour = [255, 0, 0, 255];
      point1 = new cv.Point(0, 0);
      point2 = new cv.Point(0, 0);
    }

    afPredictionResult.innerHTML = "--";
    aflutterPredictionResult.innerHTML = "--";
    chfPredictionResult.innerHTML = "--";
    pvcsPredictionResult.innerHTML = "--";
    sbPredictionResult.innerHTML = "--";
    svtPredictionResult.innerHTML = "--";
    afPredictionConf.innerHTML = "--";
    aflutterPredictionConf.innerHTML = "--";
    chfPredictionConf.innerHTML = "--";
    pvcsPredictionConf.innerHTML = "--";
    sbPredictionConf.innerHTML = "--";
    svtPredictionConf.innerHTML = "--";
  });

  meetingSocket.on("remote_result", (response) => {
    console.log("remote_result", response);

    // start processing.
    let imgData = localStream.getCurrentFrameData();
    // let dst = new cv.Mat();
    let src = cv.matFromImageData(imgData);
    // let srcImgData = new ImageData(new Uint8ClampedArray(src.data), src.cols, src.rows);
    // console.log('localStream', localStream);
    // let src = new cv.Mat(localVideo.height, localVideo.width, cv.CV_8UC4);
    // let dst = new cv.Mat(localVideo.height, localVideo.width, cv.CV_8UC1);

    // localCap.read(src);
    cv.flip(src, src, 1);
    // cv.cvtColor(src, dst, cv.COLOR_RGBA2RGB);
    src.copyTo(dst);

    if (response.calculation_parameters.bb_colour[1] === 255) {
      bbColour = [0, 255, 0, 255];
      localVideoFaceRect.style.stroke = "lime";
    } else {
      bbColour = [255, 0, 0, 255];
      localVideoFaceRect.style.stroke = "red";
    }
    // let point1 = new cv.Point(response.bb_points[0], response.bb_points[1]);
    // let point2 = new cv.Point(response.bb_points[2], response.bb_points[3]);

    // cv.rectangle(dst, point1, point2, bbColour, 2);
    cv.imshow(canvasEl.id, dst);

    src.delete();
    // dst.delete();
    delete imgData;
    // delete point1;
    // delete point2;
    // delete srcImgData;

    resultsDiv.innerHTML = "";

    faceReading = response.request_calculation_parameters.face_detected;
    heart_rate = parseInt(response.vitals_results.heart_rate.toFixed(0));
    resp_rate = parseInt(response.vitals_results.resp_rate.toFixed(0));
    resp_rate_motion = parseInt(response.vitals_results.resp_rate_motion.toFixed(0));
    spo2_rate = parseInt(response.vitals_results.spo2_rate.toFixed(0));
    hrv_rate = parseInt(response.vitals_results.hrv_rate.toFixed(0));
    mean_rr = parseInt(response.vitals_results.mean_rr.toFixed(0));

    heartResult.innerHTML = heart_rate;
    respResult.innerHTML = resp_rate;
    respResultMotion.innerHTML = resp_rate_motion;
    spo2Result.innerHTML = spo2_rate;
    hrvResult.innerHTML = hrv_rate;
    meanrrResult.innerHTML = mean_rr;
    // pctComplete = (((response.calculation_parameters.N - response.calculation_parameters.frames_needed) / response.calculation_parameters.N) * 100);
    pctComplete = response.calculation_parameters.pct_complete;

    el("localFramesNeeded").MaterialProgress.setProgress(pctComplete);

    if (response.calculation_parameters.stable_readings == true) {
      stableReadingsEl.innerHTML = "<strong>STABLE READINGS</strong>";
      localVideoContainer.classList.remove("hidden");
      localFacePositionSvg.classList.add("hidden");
      localVideoFaceRect.style.stroke = "red";
      // canvasEl.classList.add("hidden");

      getVitalsBtn.disabled = false;
      startCameraBtn.disabled = false;
      if (!inRoom && telemedicine.checked) {
        joinCallButton.disabled = false;
      }
      el("localFramesNeeded").classList.add("hidden");
      el("localFramesNeededLabel").classList.add("hidden");
    }
    delete response;
  });

  meetingSocket.on("arrhythmia_remote_result", (arrhythmia_detection_results) => {
    if (arrhythmia_detection_results) {
      if (!arrhythmia_detection_results.atrial_fibrillation.detected) {
        afPrediction = "N";
        afPredText = "Normal";
      } else {
        afPrediction = "I";
        afPredText = "AFIB";
      }

      if (!arrhythmia_detection_results.atrial_flutter.detected) {
        aflutterPrediction = "N";
        aflutterPredText = "Normal";
      } else {
        aflutterPrediction = "I";
        aflutterPredText = "AFLUTTER";
      }

      if (!arrhythmia_detection_results.congestive_heart_failure.detected) {
        chfPrediction = "N";
        chfPredText = "Normal";
      } else {
        chfPrediction = "I";
        chfPredText = "CHF";
      }

      if (!arrhythmia_detection_results.heart_block.detected) {
        hbPrediction = "N";
        hbPredText = "Normal";
      } else {
        hbPrediction = "I";
        hbPredText = "HEART BLOCK";
      }

      if (!arrhythmia_detection_results.myocardial_infarction.detected) {
        myoInfPrediction = "N";
        myoInfPredText = "Normal";
      } else {
        myoInfPrediction = "I";
        myoInfPredText = "MYO INF";
      }

      if (!arrhythmia_detection_results.premature_ventricular_contractions.detected) {
        pvcsPrediction = "N";
        pvcsPredText = "Normal";
      } else {
        pvcsPrediction = "I";
        pvcsPredText = "PVC";
      }

      if (!arrhythmia_detection_results.sinus_bradycardia.detected) {
        sbPrediction = "N";
        sbPredText = "Normal";
      } else {
        sbPrediction = "I";
        sbPredText = "SB";
      }

      if (!arrhythmia_detection_results.supraventricular_tachycardia.detected) {
        svtPrediction = "N";
        svtPredText = "Normal";
      } else {
        svtPrediction = "I";
        svtPredText = "SVT";
      }

      afConf = arrhythmia_detection_results.atrial_fibrillation.confidence;
      aflutterConf = arrhythmia_detection_results.atrial_flutter.confidence;
      apneaConf = arrhythmia_detection_results.apnea.confidence;
      chfConf = arrhythmia_detection_results.congestive_heart_failure.confidence;
      hbConf = arrhythmia_detection_results.heart_block.confidence;
      myoInfConf = arrhythmia_detection_results.myocardial_infarction.confidence;
      pvcsConf = arrhythmia_detection_results.premature_ventricular_contractions.confidence;
      sbConf = svtConf = arrhythmia_detection_results.sinus_bradycardia.confidence;
      svtConf = arrhythmia_detection_results.supraventricular_tachycardia.confidence;
      afPredictionResult.innerHTML = afPrediction;
      aflutterPredictionResult.innerHTML = aflutterPrediction;
      apneaPredictionResult.innerHTML = apneaPrediction;
      chfPredictionResult.innerHTML = chfPrediction;
      hbPredictionResult.innerHTML = hbPrediction;
      myoInfPredictionResult.innerHTML = myoInfPrediction;
      pvcsPredictionResult.innerHTML = pvcsPrediction;
      sbPredictionResult.innerHTML = sbPrediction;
      svtPredictionResult.innerHTML = svtPrediction;
      afPredictionConf.innerHTML = afConf + "%";
      aflutterPredictionConf.innerHTML = aflutterConf + "%";
      apneaPredictionConf.innerHTML = apneaConf + "%";
      chfPredictionConf.innerHTML = chfConf + "%";
      hbPredictionConf.innerHTML = hbConf + "%";
      myoInfoPredictionConf.innerHTML = myoInfConf + "%";
      pvcsPredictionConf.innerHTML = pvcsConf + "%";
      sbPredictionConf.innerHTML = sbConf + "%";
      svtPredictionConf.innerHTML = svtConf + "%";
    }
  });

  meetingSocket.on("remote_stable_readings", (room) => {
    console.log("room name: " + room + " stable readings received");
  });

  meetingSocket.on("vitals_complete", (room) => {
    console.log("room name: " + room + " vitals complete");
    el("getVitals").removeAttribute("disabled");
  });

  room = prompt("Enter room name:");
  if (room != "") {
    callParams = {
      channelName: room,
      uid: uid,
    };
    meetingSocket.emit("get_token", callParams);
    meetingSocket.emit("join", room);
    joinCallButton.setAttribute("disabled", true);
  } else {
    alert("Room name cannot be blank");
    console.log("Room name cannot be blank");
  }

  meetingSocket.on("peer_left", (room) => {
    console.log("room name: " + room + " peer left the room");
    resetCanvas(remoteCanvasEl);
    remoteCanvasEl.classList.remove("hidden");
    remoteVideo.classList.add("hidden");
    if (cameraStart) {
      localVideoContainer.classList.remove("hidden");
      canvasEl.classList.add("hidden");
      resetCanvas(canvasEl);
      getVitalsBtn.removeAttribute("disabled");
    }
    localVideoContainer.click();
    el("localFramesNeeded").classList.add("hidden");
    el("localFramesNeededLabel").classList.add("hidden");
    el("remoteFramesNeeded").classList.add("hidden");
    el("remoteFramesNeededLabel").classList.add("hidden");
  });
}

// Agora Video Call Functions
// Client Setup
// Defines a client for RTC
function onAgoraReady() {
  client = AgoraRTC.createClient({
    mode: "rtc",
    codec: "vp8",
  });

  //When a stream is added to a channel
  client.on("user-published", async (remoteUser, mediaType) => {
    console.log("inRoom", inRoom);
    if (inRoom) {
      await client.subscribe(remoteUser, mediaType);
      if (mediaType === "video") {
        console.log("subscribe video success");
        remoteCanvasEl.classList.add("hidden");
        remoteVideo.classList.remove("hidden");
        remoteUser.videoTrack.play("remoteVideo", {
          mirror: true,
        });
        remoteStream = remoteUser.videoTrack;
        // console.log('remote_user', remoteUser);
        let remoteVideoEl = el("video_" + remoteUser._videoTrack._ID);
        remoteCanvasEl.style.height = remoteVideoEl.offsetHeight + "px";
        remoteCanvasEl.style.width = remoteVideoEl.offsetWidth + "px";
        remoteCanvasEl.style.objectFit = "cover";
        remoteVideoFaceRect.setAttribute("height", 0);
        remoteVideoFaceRect.setAttribute("width", 0);
        remoteVideoFaceRect.style.stroke = "red";
      }
    }
  });

  // When a stream is removed from a channel
  client.on("user-unpublished", async (remoteUser) => {
    await client.unsubscribe(remoteUser);
    remoteCanvasEl.classList.remove("hidden");
    remoteVideo.classList.add("hidden");
    streaming = false;
  });

  // Token will expire
  client.on("token-privilege-will-expire", () => {
    meetingSocket.emit("get_token", callParams);
  });

  // Token did expire
  client.on("token-privilege-did-expire", () => {
    meetingSocket.emit("leave_room", room);
    joinRoom();
  });
}

async function callAction(room) {
  try {
    // The client joins the channel
    await client.join("4b3c254af5514ef7bad5309324f3fa93", room, agoraToken, uid);

    console.log("join success");
    await client.publish([localStream]);
    console.log("publish success");
    hangupButton.removeAttribute("disabled");
  } catch (e) {
    handleError(e);
  }
}

