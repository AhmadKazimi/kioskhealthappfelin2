async function startCamera(resolution, videoId) {
  const videoSelect = el("cam-select");
  const videoSource = videoSelect.value;
  // console.log(videoSource);

  const constraints = {
    qvga: {
      width: { ideal: 320 },
      height: { ideal: 240 },
      cameraId: videoSource ? { exact: videoSource } : undefined,
    },
    vga: {
      width: { ideal: 640 },
      height: { ideal: 480 },
      cameraId: videoSource ? { exact: videoSource } : undefined,
    },
    vga_portrait: {
      width: { ideal: 480 },
      height: { ideal: 640 },
      cameraId: videoSource ? { exact: videoSource } : undefined,
    },
  };
  let video = el(videoId);
  if (!video) {
    video = document.createElement("localVideoContainer");
  }
  let videoConstraint = constraints[resolution];
  if (!videoConstraint) {
    videoConstraint = true;
  }

  localStream = await AgoraRTC.createCameraVideoTrack({
    cameraId: videoConstraint.cameraId.exact,
    encoderConfig: {
      width: videoConstraint.width,
      height: videoConstraint.height,
    },
  });

  if (localStream) {
    localStream.play(videoId, (config = { fit: "contain" }));
    // console.log(localStream);
    selectedVideo = el("video_" + localStream.getTrackId());
    localVideo = el("video_" + localStream.getTrackId());
    selectedContainer = el("localVideoContainer");
    selectedCanvas = el("canvasElement");
    selectedCanvas.style.height = selectedVideo.offsetHeight + "px";
    selectedCanvas.style.width = selectedVideo.offsetWidth + "px";
    selectedCanvas.width = selectedVideo.videoWidth;
    selectedCanvas.height = selectedVideo.videoHeight;
    selectedCanvas.style.objectFit = "contain";
    console.log("selected_canvas_height", selectedCanvas.style.height);
    console.log("selected_canvas_width", selectedCanvas.style.width);
    selectedStream = localStream;
  }
}

